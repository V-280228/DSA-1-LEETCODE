class Solution {
    public int superPow(int a, int[] b) {
        int result=1;
        a=a%1337;
        for(int i=0;i<b.length;i++){
            result=(pow(result,10)*pow(a,b[i]))%1337;
        }
        return result;
    }
    public int pow(int a,int b){
        int ans=1;
        for(int i=0;i<b;i++){
            ans=(ans*a)%1337;
        }
        return ans;
    }
}
